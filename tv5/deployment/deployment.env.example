# WP13 Deployment Environment Configuration
# Ports
WP13_PORT=5173
TV4_PORT=8200

# Upstream Service URLs (External/Containerized)
TV1_URL=http://127.0.0.1:8000
WP04_URL=http://127.0.0.1:8100

# Runtime Mode (0 for live, 1 for deterministic fixture mode)
TV4_FIXTURE_MODE=0
VITE_SYSTEM_MODE=live

# Config Paths & Certifications
TV4_CONFIG=configs/default.yaml
TV4_EXACT_CERTIFICATION_PATH=D:/aic226/tv2_1/WP09/configs/certifications/run_v1_batch1.json

# Read-Only Upstream Asset Mounts
RAW_VIDEO_ROOT=D:/aic226/tv1/data/raw
RUNS_ROOT=D:/aic226/tv1/data/runs
WP03_ARTIFACT_ROOT=D:/aic226/tv2_1/WP03/artifacts/full-run-1
WP09_ROOT=D:/aic226/tv2_1/WP09
